<!--
  The modaliases below cover the interfaces in udev/70-qdl.rules.in.
  Protocol ff is also used by DIAG and other vendor-specific interfaces,
  so it is limited to the EDL (9008) and crashdump (900e) product IDs.
-->
<component type="console-application">
  <id>com.github.linux_msm.qdl</id>
  <metadata_license>MIT OR BSD-3-Clause</metadata_license>
  <project_license>BSD-3-Clause</project_license>
  <name>qdl</name>
  <summary>Flash firmware on Qualcomm devices in Emergency Download mode</summary>
  <description>
    <p>
      qdl flashes Qualcomm devices over USB in Emergency Download (EDL) mode.
      It can upload a Firehose programmer to a device, flash device storage,
      read device storage and collect a RAM dump from a crashed device.
    </p>
  </description>
  <url type="homepage">https://github.com/linux-msm/qdl</url>
  <provides>
    <binary>qdl</binary>
    <modalias>usb:v05C6p*d*dc*dsc*dp*icFFiscFFip10in*</modalias>
    <modalias>usb:v05C6p*d*dc*dsc*dp*icFFiscFFip11in*</modalias>
    <modalias>usb:v05C6p*d*dc*dsc*dp*icFFiscFFip13in*</modalias>
    <modalias>usb:v05C6p9008d*dc*dsc*dp*icFFiscFFipFFin*</modalias>
    <modalias>usb:v05C6p900Ed*dc*dsc*dp*icFFiscFFipFFin*</modalias>
  </provides>
</component>
